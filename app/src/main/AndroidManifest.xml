<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Voiceover recording only; the audio never leaves the device. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      In-app camera (F26). Used only by the camera screen to preview, shoot and
      record locally; the app has no network permission, so nothing is uploaded.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!--
      Everything runs on-device, so the app must not be able to reach the
      network at all. Some library manifests (Media3/ExoPlayer) declare INTERNET
      for their streaming data sources; it is stripped from the merged manifest
      because this app only ever plays and writes local files.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <application
        android:name=".ZcutApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zcut">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Zcut.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Shares a finished export through the system share sheet. The provider
          only exposes filesDir/exports (see res/xml/file_paths.xml), is not
          exported, and grants read access per URI.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
